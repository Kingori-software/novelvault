<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Clothing Store — Login</title>
<link rel="stylesheet" href="style.css" />
</head>
<body>

  <!-- ===== Animated background orbs ===== -->
  <div class="orb orb-a"></div>
  <div class="orb orb-b"></div>
  <div class="orb orb-c"></div>

  <!-- ===================================================== -->
  <!-- ==================== LOGIN VIEW ===================== -->
  <!-- ===================================================== -->
  <section id="loginView" class="view active">
    <div class="login-card">

      <div class="logo">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3.5"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M32 22a7 7 0 1 1 7-7" />
          <path d="M32 22v5" />
          <path d="M32 27 9 44.5A4.5 4.5 0 0 0 11.7 52h40.6a4.5 4.5 0 0 0 2.7-7.5L32 27Z" />
        </svg>
      </div>

      <h1 class="brand">Clothing<span>Store</span></h1>
      <p class="subtitle">Sign in to enter the collection</p>

      <form id="loginForm" novalidate>
        <div class="field">
          <label for="username">Name</label>
          <input id="username" type="text" placeholder="Enter your name" autocomplete="off" spellcheck="false" />
        </div>

        <div class="field">
          <label for="password">Password</label>
          <div class="pw-wrap">
            <input id="password" type="password" placeholder="Enter your password" autocomplete="off" />
            <button type="button" class="eye" id="togglePw" aria-label="Show password">👁</button>
          </div>
        </div>

        <button type="submit" class="btn-login" id="loginBtn">Enter Store</button>
        <p class="error" id="errorMsg"></p>
      </form>

      <p class="hint">Demo accounts &middot; User1 &nbsp;|&nbsp; Boss1</p>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- ==================== STORE VIEW ===================== -->
  <!-- ===================================================== -->
  <section id="storeView" class="view">
    <header class="topbar">
      <div class="topbar-left">
        <div class="mini-logo">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M32 22a7 7 0 1 1 7-7" />
            <path d="M32 22v5" />
            <path d="M32 27 9 44.5A4.5 4.5 0 0 0 11.7 52h40.6a4.5 4.5 0 0 0 2.7-7.5L32 27Z" />
          </svg>
        </div>
        <div>
          <h2 class="top-title">Clothing Store</h2>
          <p class="top-sub" id="storeGreeting">Welcome</p>
        </div>
      </div>

      <div class="topbar-right">
        <div class="cart">
          🛍 <span class="cart-count" id="cartCount">0</span>
        </div>
        <button class="btn-ghost" data-logout>Log out</button>
      </div>
    </header>

    <div class="section-head">
      <h2>New Season Drops</h2>
      <p>Five hand-picked pieces, ready to ship.</p>
    </div>

    <main class="grid" id="productGrid"></main>
  </section>

  <!-- ===================================================== -->
  <!-- ==================== METALS VIEW ==================== -->
  <!-- ===================================================== -->
  <section id="metalsView" class="view">
    <header class="topbar metals-topbar">
      <div class="topbar-left">
        <div class="mini-logo gold-logo">◆</div>
        <div>
          <h2 class="top-title gold-text">Precious Metals Exchange</h2>
          <p class="top-sub" id="metalGreeting">Private access</p>
        </div>
      </div>
      <div class="topbar-right">
        <span class="boss-badge">BOSS ACCESS</span>
        <button class="btn-ghost" data-logout>Log out</button>
      </div>
    </header>

    <div class="section-head">
      <h2 class="gold-text">Today&rsquo;s High-Value Metals</h2>
      <p>Approximate market price per gram &middot; USD</p>
    </div>

    <main class="metal-list" id="metalGrid"></main>
  </section>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <script src="script.js"></script>
</body>
</html>